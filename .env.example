# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your tokens.
#
#     cp .env.example .env
#
# `.env` is gitignored — never commit it, and never paste a real token into
# an issue, a log or a screenshot. Tokens are read at runtime and are only
# ever shown masked (e.g. hf_abc…wxyz).
# ---------------------------------------------------------------------------

# --- HuggingFace (required for gated models such as Llama-3.2) --------------
# Create one at https://huggingface.co/settings/tokens
#   - type "Read" is enough
#   - if you use a fine-grained token, tick the gated repo you need
# Then accept the licence at https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct
#
# The same token is reused to fetch the dataset (`stanfordnlp/imdb`) via
# `datasets.load_dataset()`. That dataset is public, so HF_TOKEN is not
# strictly required for it - only for the gated model checkpoint.
HF_TOKEN=

# --- Optional tuning -------------------------------------------------------
# Move the HuggingFace cache (weights are several GB) to another disk:
# HF_HOME=/mnt/bigdisk/hf_cache

# Work entirely from the local cache, no network calls:
# HF_HUB_OFFLINE=1
